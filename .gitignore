.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
.terragrunt-cache
.env
.worktrees/
tfplan*
# Generated by Terragrunt on every run (root.hcl's remote_state and each unit's
# generate "provider" block). Never commit them: a pre-1.0 Terragrunt writes the
# output into the unit directory, so tracking them turns a local plan into a
# diff - and a credential interpolated into a generate block would land in the
# commit. bootstrap/_backend.tf is hand-written plain OpenTofu and stays tracked.
modules/**/_backend.tf
modules/**/_provider.tf
