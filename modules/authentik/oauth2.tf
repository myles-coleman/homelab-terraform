# OAuth2 / OpenID Connect applications.
#
# These are for services that implement a real OIDC client (Open WebUI), as
# opposed to the forward-auth proxy providers in providers.tf, which authenticate
# the browser in front of an app that has no idea it is behind a gate.
#
# A generated client secret ends up in Terraform state because the provider
# creates it. It is marked sensitive on the output and is also readable from
# Authentik; the value the application consumes lives in Vaultwarden and reaches
# the pod through External Secrets, never through this repository.

# Authentik ships a self-signed key pair used to sign tokens for providers that
# do not bring their own. Looking it up by name keeps the module from minting a
# second certificate nobody asked for.
data "authentik_certificate_key_pair" "signing" {
  name = "authentik Self-signed Certificate"

  lifecycle {
    postcondition {
      condition     = self.id != null && self.id != ""
      error_message = "No Authentik certificate key pair named \"authentik Self-signed Certificate\" was found. The default blueprint creates it; if it was renamed or deleted, set signing_key explicitly for oauth2_applications."
    }
  }
}

# The scope mappings Authentik ships. Requesting `openid email profile` from a
# client only works if these are attached to the provider, and they are matched
# by name because the provider has no stable slug for them.
data "authentik_property_mapping_provider_scope" "openid" {
  name = "authentik default OAuth Mapping: OpenID 'openid'"
}

data "authentik_property_mapping_provider_scope" "email" {
  name = "authentik default OAuth Mapping: OpenID 'email'"
}

data "authentik_property_mapping_provider_scope" "profile" {
  name = "authentik default OAuth Mapping: OpenID 'profile'"
}

resource "authentik_provider_oauth2" "apps" {
  for_each = var.oauth2_applications

  name = each.value.name

  # The provider requires a client_id but does not generate one, so it is taken
  # from the slug: stable across applies, readable in an Authentik audit log, and
  # unique because slugs are. It is not a secret — the client secret is, and that
  # one is generated by Authentik and never enters this repository.
  client_id          = each.value.slug
  client_type        = each.value.client_type
  authorization_flow = data.authentik_flow.authorization.id
  invalidation_flow  = data.authentik_flow.invalidation.id
  signing_key        = data.authentik_certificate_key_pair.signing.id

  # Strict matching: a client that sends a slightly different callback URL must
  # fail rather than be redirected somewhere it did not register.
  allowed_redirect_uris = [
    for uri in each.value.redirect_uris : {
      matching_mode = "strict"
      url           = uri
    }
  ]

  property_mappings = [
    data.authentik_property_mapping_provider_scope.openid.id,
    data.authentik_property_mapping_provider_scope.email.id,
    data.authentik_property_mapping_provider_scope.profile.id,
  ]

  access_code_validity   = each.value.access_code_validity
  access_token_validity  = each.value.access_token_validity
  refresh_token_validity = each.value.refresh_token_validity
}

resource "authentik_application" "oauth2" {
  for_each = var.oauth2_applications

  name               = each.value.name
  slug               = each.value.slug
  protocol_provider  = authentik_provider_oauth2.apps[each.key].id
  policy_engine_mode = "any"
  meta_publisher     = "homelab"

  # As with the proxy applications: no `group` field, because that admits every
  # member regardless of policy. Authorization is a policy binding per group.
}
