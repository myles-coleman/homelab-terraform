{
	"groups": {
		"group:admin": ["mylescoleman05@gmail.com"],
	},
	"tagOwners": {
		"tag:ci":             ["group:admin"],
		"tag:ci-plan":        ["group:admin"],
		"tag:server":         ["group:admin"],
		"tag:infrastructure": ["group:admin"],
		"tag:sandbox":        ["group:admin"],
		"tag:media-egress":   ["group:admin"],
	},
	"acls": [
		// 1. Allow admins to access all Tailscale devices
		{
			"action": "accept",
			"src":    ["group:admin"],
			"dst":    ["*:*"],
		},
		// 2. Allow admins to reach every LAN segment through the Subnet Router,
		// without using the Exit Node. Spec 29 replaced the flat 10.0.0.0/24 LAN
		// with four segments; the management subnet (192.168.200.0/24) is never
		// advertised and is deliberately absent here.
		{
			"action": "accept",
			"src":    ["group:admin"],
			"dst": [
				"10.0.0.0/24:*",  // homelab (estate switch, k3s, PiKVM)
				"10.20.0.0/24:*", // gaming
				"10.30.0.0/24:*", // ai
				"10.50.0.0/24:*", // wifi
			],
		},
		// 3. Allow CI runner to access the k3s nodes
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst": [
				"10.0.0.140/32:22",
				"10.0.0.141/32:22",
				"10.0.0.142/32:22",
				"10.0.0.143/32:22",
				"10.0.0.144/32:22",
				"10.0.0.145/32:22",
				// Kubernetes API via kube-vip (Terraform argocd-* plans/applies)
				"10.0.0.200/32:6443",
				// Traefik ingress (SigNoz dashboard endpoint for the smoke check)
				"10.0.0.99/32:443",
			],
		},
		// 4. Allow the CI runner to use the exit node (internet + DNS via the vault).
		//    Exit-node use requires an explicit autogroup:internet grant.
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst":    ["autogroup:internet:*"],
		},
		// 5. Allow the CI runner to SSH to deploy targets only.
		//    (Rule 3 covers k3s; the deploy/closure-diff hosts were missing.)
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst": [
				"100.110.170.34:22", // homelab (Tailscale IP)
				"100.127.170.8:22", // bee-gpu-server (Tailscale IP)
				"100.116.132.19:22", // pikvm (Tailscale IP)
				"100.112.185.27:22", // protecli-vault (Tailscale IP)
			],
		},
		// 6. Plan jobs join as tag:ci-plan, separate from tag:ci, so a branch plan
		//    does not hold the deploy tag's policy position. Only what a plan
		//    reads: the Kubernetes API and Traefik. Apply keeps tag:ci.
		{
			"action": "accept",
			"src":    ["tag:ci-plan"],
			"dst": [
				// Kubernetes API via kube-vip (Terraform argocd-* plans)
				"10.0.0.200/32:6443",
				// Traefik ingress (the SigNoz endpoint a plan reads)
				"10.0.0.99/32:443",
			],
		},
		{
			"action": "accept",
			"src":    ["tag:sandbox"],
			"dst":    ["100.127.170.8:8080"],
		},
		// 7. Allow the k3s nodes to reach Strata's model endpoint only.
		//    A pod's traffic leaves as the node's own tailnet identity, and every
		//    k3s node carries tag:server, so the grant is written against the tag
		//    rather than a pod or a user. One host, one port: SSH and every other
		//    service on bee-gpu-server stay denied (spec 24).
		{
			"action": "accept",
			"src":    ["tag:server"],
			"dst":    ["100.127.170.8:8080"],
		},
		// 8. k8s egress sidecars (qBittorrent, Prowlarr) may use the tailnet
		//    exit node for internet, and reach Pi-hole/Unbound on the Vault for
		//    DNS. No other tailnet or LAN access is granted.
		{
			"action": "accept",
			"src":    ["tag:media-egress"],
			"dst":    ["autogroup:internet:*"],
		},
		{
			"action": "accept",
			"src":    ["tag:media-egress"],
			"dst":    ["100.112.185.27:53"],
		},
	],
	// Assertions the policy must keep satisfying. Tailscale evaluates these when
	// the policy is applied: a failing test rejects the whole file, so a later
	// edit cannot quietly drop the model path or widen it to SSH.
	"tests": [
		{
			"src":    "tag:server",
			"accept": ["100.127.170.8:8080"],
			"deny":   ["100.127.170.8:22"],
		},
		{
			"src":    "tag:sandbox",
			"accept": ["100.127.170.8:8080"],
		},
		{
			"src":    "tag:media-egress",
			"accept": ["100.112.185.27:53"],
			"deny":   ["100.112.185.27:22", "10.0.0.150:22", "10.30.0.10:8080"],
		},
		// Spec 29: an admin reaches a host in every segment. The management
		// subnet (192.168.200.0/24) is deliberately not asserted here: rule 1
		// already grants admins "*:*", so an ACL test could not deny it.
		// Management stays unreachable because the Vault never advertises that
		// prefix and its firewall drops every non-enp6s0 packet to it.
		{
			"src":    "group:admin",
			"accept": [
				"10.0.0.150:22", // homelab
				"10.20.0.10:22", // gaming (myles-pc)
				"10.30.0.10:22", // ai (bee-gpu-server)
				"10.50.0.1:22",  // wifi gateway
			],
		},
		// Spec 29: least privilege for the tagged fleet. CI keeps its explicit
		// k3s/ingress grants and gets nothing on the gaming/AI/wifi segments.
		{
			"src":    "tag:ci",
			"accept": ["10.0.0.140:22"],
			"deny":   ["10.20.0.10:22", "10.30.0.10:22", "10.50.0.1:22"],
		},
		// The k3s nodes are on the homelab segment itself and need no tailnet
		// LAN grant (task 4.3): everything LAN-side is denied.
		{
			"src":  "tag:server",
			"deny": ["10.0.0.150:22", "10.20.0.10:22", "10.30.0.10:22", "10.50.0.1:22"],
		},
	],
	"autoApprovers": {
		"exitNode": ["tag:infrastructure"],
	},
}
