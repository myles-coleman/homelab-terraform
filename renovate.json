{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 5,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "separateMajorMinor": true,
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["pre-commit"],
      "semanticCommitType": "chore"
    }
  ]
}
